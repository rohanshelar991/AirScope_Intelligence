# Frontend key for direct weather UI use
REACT_APP_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Pipeline ingestion keys
WAQI_API_KEY=your_waqi_api_key_here
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional comma-separated cities to monitor.
# Leave unset to use the built-in premium 100-city global network.
# CITY_LIST=Mumbai,Delhi,London,Los Angeles

# Alerting
ALERT_MODE=console
ALERT_RECIPIENT=team@example.com
SMS_RECIPIENT=+911234567890
AQI_WARNING_THRESHOLD=100
AQI_DANGER_THRESHOLD=150
AQI_HAZARDOUS_THRESHOLD=200
AQI_SPIKE_DELTA=35
PIPELINE_CRON=*/30 * * * *

# Optional Gmail SMTP delivery for alert emails
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional Twilio SMS delivery
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
